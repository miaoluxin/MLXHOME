{
  "name": "mlxforge",
  "version": "1.0.0",
  "author": "MLX Forge",
  "description": "MLX Forge — AI-powered Windows IDE with dual terminals, CodeMirror 6 editor, file management, conversation management, and prompt management",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "electron:build": "vite build && electron-builder --win && node -e \"const fs=require('fs');const p='release/win-unpacked';if(fs.existsSync(p))fs.rmSync(p,{recursive:true});try{fs.unlinkSync('release/builder-debug.yml')}catch(e){}\"",
    "electron:build:win": "vite build && electron-builder --win && node -e \"const fs=require('fs');const p='release/win-unpacked';if(fs.existsSync(p))fs.rmSync(p,{recursive:true});try{fs.unlinkSync('release/builder-debug.yml')}catch(e){}\"",
    "postinstall": "echo '提示: 请在安装 Visual Studio Build Tools 后运行 npx electron-rebuild -f -w node-pty'",
    "preview": "vite preview"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/fold": "^0.19.4",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.0",
    "@codemirror/view": "^6.43.4",
    "@lydell/node-pty": "^1.2.0-beta.12",
    "@types/markdown-it": "^14.1.2",
    "@xterm/addon-fit": "^0.11.0",
    "chokidar": "^4.0.3",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.2",
    "electron-store": "^10.0.0",
    "framer-motion": "^12.6.0",
    "markdown-it": "^14.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-icons": "^5.5.0",
    "xterm": "^5.3.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.5.2",
    "autoprefixer": "^10.4.20",
    "electron": "^43.0.0",
    "electron-builder": "^25.1.8",
    "electron-rebuild": "^3.2.9",
    "postcss": "^8.5.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.0",
    "vite": "^6.2.0",
    "vite-plugin-electron": "^1.1.0",
    "vite-plugin-electron-renderer": "^1.0.0"
  }
}
